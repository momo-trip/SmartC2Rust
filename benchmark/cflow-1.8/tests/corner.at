AT_BANNER([special cases])

CFLOW_OPT([-v],
[CFLOW_TEST([empty expression and closing brace],
[corner corner1],
[x = }],
[],
[prog:1: expected expression near `}'
])
])

CFLOW_OPT([-it -x],
[CFLOW_TEST([duplicate typedef],
[corner corner2],
[typedef struct X X;
typedef struct X { int i; } X;
],
[X t prog:2
])
])