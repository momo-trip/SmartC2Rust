	$(AM_V_GEN)sed -e "s|[@]g[@]|$(g)|g" \
	    -e "s|[@]VERSION[@]|$(VERSION)|" \
	    -e $(SH_SCRIPT_SED_CMD) $(pic2graph_srcdir)/pic2graph.sh \
	    >$@ \
	&& chmod +x $@

