	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(momprocessedexampledir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(momprocessedexampledir)" || exit $$?; \
	done

